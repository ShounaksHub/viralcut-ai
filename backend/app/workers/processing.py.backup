import json
import logging
import shutil
from app import database as db
from app.config import STORAGE
from app.services.media import probe, extract_audio
from app.services.downloader import download
from app.services.transcription import transcribe
from app.services.highlights import select_clips
from app.services.render import render

logger=logging.getLogger(__name__)

def process_job(job_id,count=4,theme='professional'):
    try:
        job=db.get(job_id)
        if not job:raise RuntimeError('Job not found')
        workspace=STORAGE/'temp'/job_id;workspace.mkdir(parents=True,exist_ok=True)
        if job['source_type']=='url' and not job['filename']:
            db.update(job_id,status='processing',stage='Downloading video',progress=None)
            source=download(job['source_url'],workspace,progress=lambda pct:db.update(job_id,progress=pct))
            dest=STORAGE/'uploads'/(job_id+source.suffix.lower());shutil.copy2(source,dest);source=dest
            db.update(job_id,filename=source.name)
        else:
            source=STORAGE/'uploads'/job['filename']
        if not source.is_file():raise RuntimeError('Original video was not found')
        db.update(job_id,status='processing',stage='Inspecting video',progress=None,error=None)
        meta=probe(source);db.update(job_id,metadata=meta)
        if not meta['has_audio']:raise RuntimeError('This video has no audio for speech-based highlight detection.')
        wav=STORAGE/'audio'/f'{job_id}.wav'
        db.update(job_id,stage='Extracting audio')
        if not wav.exists():extract_audio(source,wav)
        transcript_path=STORAGE/'transcripts'/f'{job_id}.json'
        db.update(job_id,stage='Transcribing with Whisper',progress=None)
        if not transcript_path.exists():
            result=transcribe(wav)
            transcript_path.write_text(json.dumps(result,ensure_ascii=False,indent=2),encoding='utf-8')
        else:result=json.loads(transcript_path.read_text(encoding='utf-8'))
        db.update(job_id,transcript_path=str(transcript_path),stage='Selecting highlights with Gemini AI')
        selections=select_clips(result,meta['duration'],count=count)
        manifest={'clips':[],'source':source.name,'theme':theme,'version':1}
        save_manifest(job_id,manifest)
        for idx,selection in enumerate(selections):
            db.update(job_id,stage=f'Rendering vertical clip {idx+1}/{len(selections)}',progress=None)
            clip_id=f'{idx+1:02d}';output=STORAGE/'clips'/f'{job_id}_{clip_id}.mp4'
            render(source,result['words'],selection['start'],selection['end'],output,theme=theme)
            selection.update(id=clip_id,filename=output.name,theme=theme,crop_x=None)
            manifest['clips'].append(selection)
            save_manifest(job_id,manifest)
        db.update(job_id,status='completed',stage=f'{len(selections)} clips ready',progress=100)
    except Exception as exc:
        logger.exception('Job %s failed',job_id)
        db.update(job_id,status='failed',stage='Failed',progress=None,error=str(exc)[:1200])

def manifest_path(job_id):return STORAGE/'clips'/f'{job_id}.json'
def save_manifest(job_id,manifest):
    path=manifest_path(job_id);tmp=path.with_suffix('.tmp')
    tmp.write_text(json.dumps(manifest,ensure_ascii=False,indent=2),encoding='utf-8');tmp.replace(path)
def load_manifest(job_id):
    path=manifest_path(job_id)
    if not path.exists():return {'clips':[]}
    return json.loads(path.read_text(encoding='utf-8'))
