'use strict';
const $=id=>document.getElementById(id);
let mode='upload',selectedFile=null,uploading=false,selectedJob=null,jobCache=[];
function error(message){$('error').textContent=message||'';$('error').hidden=!message}
function chooseMode(value){mode=value;$('uploadSection').hidden=value!=='upload';$('urlSection').hidden=value!=='url';$('uploadTab').classList.toggle('selected',value==='upload');$('urlTab').classList.toggle('selected',value==='url');error('')}
$('uploadTab').onclick=()=>chooseMode('upload');$('urlTab').onclick=()=>chooseMode('url');
$('uploadSection').onclick=()=>$('fileInput').click();
$('uploadSection').onkeydown=e=>{if(e.key==='Enter')$('fileInput').click()};
$('uploadSection').ondragover=e=>e.preventDefault();
$('uploadSection').ondrop=e=>{e.preventDefault();setFile(e.dataTransfer.files[0])};
$('fileInput').onchange=e=>setFile(e.target.files[0]);
function setFile(file){if(!file)return;selectedFile=file;$('fileName').textContent=file.name;$('fileDescription').textContent=(file.size/1048576).toFixed(1)+' MB ready to upload'}
async function json(url,options){let res=await fetch(url,options);let data=await res.json();if(!res.ok)throw Error(typeof data.detail==='string'?data.detail:'Request failed');return data}
$('analyze').onclick=async()=>{if(uploading)return;uploading=true;error('');$('analyze').disabled=true;$('analyze').textContent='Sending video…';try{let data;
if(mode==='upload'){
 if(!selectedFile)throw Error('Choose a video first.');
 data=await new Promise((resolve,reject)=>{const xhr=new XMLHttpRequest();xhr.open('POST','/api/upload');xhr.upload.onprogress=e=>{if(e.lengthComputable){$('progress').hidden=false;$('progressBar').style.width=Math.round(e.loaded/e.total*100)+'%'}};xhr.onerror=()=>reject(Error('Upload failed'));xhr.onload=()=>{let d;try{d=JSON.parse(xhr.responseText)}catch{d={}};if(xhr.status>=200&&xhr.status<300)resolve(d);else reject(Error(d.detail||'Upload failed'))};let form=new FormData();form.append('file',selectedFile);xhr.send(form)});
}else{let url=$('videoUrl').value.trim();if(!url)throw Error('Paste a public video URL first.');data=await json('/api/url',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url})})}
selectedJob=data.job_id;await refresh();
}catch(e){error(e.message)}finally{uploading=false;$('analyze').disabled=false;$('analyze').textContent='✦ Generate my clips →';$('progress').hidden=true}};
function element(name,cls,text){let el=document.createElement(name);if(cls)el.className=cls;if(text!==undefined)el.textContent=text;return el}
function time(n){n=Math.round(n);return `${Math.floor(n/60)}:${String(n%60).padStart(2,'0')}`}
async function refresh(){try{jobCache=await json('/api/jobs');$('count').textContent=`${jobCache.length} PROJECTS`;let area=$('jobs');area.replaceChildren();if(!jobCache.length)area.append(element('div','empty','Your video projects will appear here.'));
for(const j of jobCache){const box=element('div','job');const icon=element('div','job-icon','▣');box.append(icon);const detail=element('div','job-body');detail.append(element('strong','',j.source_url||j.filename||'New project'));let row=element('div','job-meta');row.append(element('span',j.status,j.stage));if(j.metadata)row.append(element('span','',`${time(j.metadata.duration)} · ${j.metadata.width}×${j.metadata.height}`));if(j.progress!=null&&j.status==='processing')row.append(element('span','',`${j.progress}%`));detail.append(row);if(j.error)detail.append(element('p','job-error',j.error));const actions=element('div','job-links');if(j.status==='completed'){const show=element('button','outline','▶ View clips');show.onclick=()=>showClips(j.id);actions.append(show)}if(j.transcript_path){const trans=element('button','outline','☰ Transcript');trans.onclick=()=>showTranscript(j.id);actions.append(trans)}if(j.status==='failed'){const retry=element('button','outline','↻ Retry');retry.onclick=async()=>{try{await json(`/api/jobs/${j.id}/retry`,{method:'POST'});refresh()}catch(e){error(e.message)}};actions.append(retry)}let del=element('button','outline','Delete');del.onclick=async()=>{if(!confirm('Delete this project and all its files?'))return;try{await json(`/api/jobs/${j.id}`,{method:'DELETE'});if(selectedJob===j.id){$('clipSection').hidden=true;$('transcriptSection').hidden=true};refresh()}catch(e){error(e.message)}};actions.append(del);detail.append(actions);box.append(detail);area.append(box)}
if(selectedJob&&jobCache.some(x=>x.id===selectedJob&&x.status==='completed')){if($('clipSection').dataset.job!==selectedJob)await showClips(selectedJob)}
}catch(e){console.error(e)}}
async function showTranscript(job){try{const data=await json(`/api/jobs/${job}/transcript`);$('transcriptSection').hidden=false;$('language').textContent=(data.language||'').toUpperCase();$('transcriptText').replaceChildren(...data.segments.map(x=>{const p=element('p');p.append(element('time','',time(x.start)+'  '));p.append(document.createTextNode(x.text));return p}));}catch(e){error(e.message)}}
async function showClips(job){try{selectedJob=job;const data=await json(`/api/jobs/${job}/clips`);$('clipSection').hidden=false;$('clipSection').dataset.job=job;$('downloadAll').href=`/api/jobs/${job}/download-all`;$('clipResults').replaceChildren();if(!data.clips.length){$('clipResults').append(element('p','','No clips yet.'));return}for(const clip of data.clips){let box=element('article','clip-card');let video=element('video','clip-video');video.controls=true;video.preload='metadata';video.src=`/api/jobs/${job}/clips/${clip.id}/video`;video.setAttribute('playsinline','');box.append(video);box.append(element('h3','',clip.title));box.append(element('div','score',`✦ ${clip.score}/100 · ${time(clip.start)}–${time(clip.end)} · ${time(clip.duration)}`));box.append(element('p','clip-reason',clip.reason));const link=element('a','outline','↓ Download MP4');link.href=`/api/jobs/${job}/clips/${clip.id}/download`;box.append(link);const edit=element('div','clip-edit');const start=element('input');start.type='number';start.step='0.1';start.min='0';start.value=clip.start;start.title='Start time (seconds)';const end=element('input');end.type='number';end.step='0.1';end.value=clip.end;end.title='End time (seconds)';const crop=element('input');crop.type='number';crop.min='0';crop.max='1';crop.step='.05';crop.placeholder='Crop (0–1)';crop.value=clip.crop_x??'';crop.title='Horizontal crop center (0=left, 1=right)';const theme=element('select');for(const t of ['professional','yellow','minimal','karaoke']){let option=element('option','',t);option.value=t;theme.append(option)}theme.value=clip.theme;edit.append(element('label','','Start (sec)'),start,element('label','','End (sec)'),end,element('label','','Caption style'),theme,element('label','','Crop center (optional)'),crop);const rerender=element('button','outline','↻ Re-render this clip');rerender.onclick=async()=>{try{let body={start:Number(start.value),end:Number(end.value),theme:theme.value};if(crop.value!=='')body.crop_x=Number(crop.value);await json(`/api/jobs/${job}/clips/${clip.id}/rerender`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});$('clipSection').dataset.job='';rerender.textContent='Rendering…';refresh()}catch(e){error(e.message)}};edit.append(rerender);box.append(edit);$('clipResults').append(box)}$('clipSection').scrollIntoView({behavior:'smooth',block:'start'})}catch(e){error(e.message)}}
refresh();setInterval(refresh,2500);

async function geminiStatus(){try{let r=await fetch('/api/settings/gemini');let d=await r.json();$('geminiStatus').textContent=d.configured?'✓ KEY CONFIGURED':'KEY REQUIRED';}catch(e){$('geminiStatus').textContent='CONNECTION ERROR'}}
$('saveGeminiKey').onclick=async()=>{const key=$('geminiKey').value.trim();$('geminiMessage').textContent='Saving...';try{let r=await fetch('/api/settings/gemini',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({api_key:key})});if(!r.ok)throw Error((await r.json()).detail||'Failed to save');$('geminiKey').value='';$('geminiMessage').textContent='Key saved on this computer.';await geminiStatus()}catch(e){$('geminiMessage').textContent=e.message}};
$('removeGeminiKey').onclick=async()=>{let r=await fetch('/api/settings/gemini',{method:'DELETE'});$('geminiMessage').textContent=r.ok?'Saved key removed.':'Could not remove key.';await geminiStatus()};
geminiStatus();
