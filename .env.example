VIRALCUT_STORAGE=./storage
VIRALCUT_MAX_UPLOAD_GB=8
VIRALCUT_WHISPER_MODEL=small
VIRALCUT_WHISPER_MODE=BALANCED
VIRALCUT_WHISPER_DEVICE=cpu
VIRALCUT_WHISPER_COMPUTE=int8
VIRALCUT_WHISPER_BATCH_SIZE=6
# Optional: limit CPU worker threads; default is a conservative Core Ultra setting.
# VIRALCUT_WHISPER_CPU_THREADS=12
VIRALCUT_GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative: set GEMINI_API_KEY in environment instead of website settings.
# GEMINI_API_KEY=YOUR_KEY
